# Image legere pour la demo heergee (Render free tier) : API + Soda + DuckDB.
# distincte de l'image Airflow (Dockerfile) qui reste utiliser en local.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /opt/airflow

COPY requirements-demo.txt .
RUN pip install --no-cache-dir -r requirements-demo.txt

COPY config/ config/
COPY contracts/ contracts/
COPY demo/ demo/
COPY loader/ loader/

EXPOSE 8000

# PORT est injecte par la plateforme (Render, etc.) — 8000 par defaut en local.
CMD ["sh", "-c", "exec uvicorn --host 0.0.0.0 --port ${PORT:-8000} demo.app:app"]
